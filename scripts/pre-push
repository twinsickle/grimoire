#!/bin/sh
# This repository's own pre-push gate: the slow lints, apart from the
# pre-commit hook `grimoire init` installs, which stays `grimoire check`.
# Install: cp scripts/pre-push .git/hooks/pre-push
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: cargo clippy"
cargo clippy --workspace --all-targets --quiet
echo "pre-push: web check"
npm --prefix web run --silent check
