{
  "name": "@grimoire/web",
  "version": "0.0.0",
  "private": true,
  "description": "React/Vite UI: the map, the board, node pages. Dark only. Built by Node at build time into web/dist, which the daemon serves with --ui-dir.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node ../scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint .",
    "shots": "node visual/shots.mjs",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "test": "vitest run",
    "behaviour": "vite build && playwright test -c behaviour/playwright.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
