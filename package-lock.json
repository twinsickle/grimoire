{
  "name": "grimoire",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "grimoire",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.6.3"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@grimoire/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@grimoire/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@grimoire/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@grimoire/web": {
      "resolved": "packages/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/cli": {
      "name": "@grimoire/cli",
      "version": "0.0.0",
      "dependencies": {
        "@grimoire/core": "*",
        "@grimoire/server": "*"
      },
      "bin": {
        "grimoire": "dist/index.js"
      },
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    },
    "packages/core": {
      "name": "@grimoire/core",
      "version": "0.0.0",
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    },
    "packages/server": {
      "name": "@grimoire/server",
      "version": "0.0.0",
      "dependencies": {
        "@grimoire/core": "*"
      },
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    },
    "packages/web": {
      "name": "@grimoire/web",
      "version": "0.0.0"
    }
  }
}
