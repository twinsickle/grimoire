{
  "name": "grimoire",
  "private": true,
  "description": "Manual and ticketing tool for developing rusty-harness. See PROPOSAL.md.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
